{
  "name": "@nik2208/sqlite-gui-node",
  "version": "2.0.2",
  "description": "GUI for Node js SQLite databases, extended to support MySQL, PostgreSQL or any other SQL databases. Provides an intuitive interface for managing and querying databases.",
  "main": "dist/index.js",
  "scripts": {
    "start": "nodemon dist/app.js",
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "test": "jest src/tests",
    "build": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nik2208/sqlite-gui-node.git"
  },
  "keywords": [
    "SQLite",
    "GUI",
    "Node js",
    "Node",
    "Interface",
    "SQL",
    "Mysql",
    "database",
    "Query",
    "Queries",
    "Typescript",
    "PostgreSQL",
    "pg"
    ],
  "author": "nik2208",
  "license": "MIT",
  "dependencies": {
    "body-parser": "^1.20.2",
    "bootstrap": "^5.3.3",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "nodemon": "^3.1.0",
    "sqlite3": "^5.1.7",
    "winston": "^3.13.0"
  },
  "bugs": {
    "url": "https://github.com/nik2208/sqlite-gui-node/issues"
  },
  "homepage": "https://github.com/nik2208/sqlite-gui-node#readme",
  "devDependencies": {
    "@babel/core": "^7.24.5",
    "@babel/preset-env": "^7.24.5",
    "@babel/preset-typescript": "^7.24.1",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.12",
    "@types/pg": "^8.11.10",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "optionalDependencies": {
    "mysql2": "^3.18.0",
    "pg": "^8.18.0"
  },
  "overrides": {
    "tar":"^7.5.4"
  }
}
